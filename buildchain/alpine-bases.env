# buildchain/alpine-bases.env - the Alpine bases this suite builds against.
#
# Single source of truth, POSIX-sourced (`. ./buildchain/alpine-bases.env`) by:
#   - .github/workflows/ci.yml   (build matrix = STABLE + PREVIOUS, per base)
#   - .github/workflows/discover-alpine.yml  (compares upstream to STABLE)
#
# Roles:
#   STABLE   - newest released Alpine; carries the consumer's 'latest'/'stable'
#              image tags. The whole suite builds on it every run.
#   PREVIOUS - the prior release, kept during the overlap window after a new
#              release ships, then emptied (retired). Empty = no overlap today.
#   EDGE     - rolling canary, built by build-edge.yml, published to alpine/edge.
#              (build-edge.yml still hardcodes the literal "edge"; this value is
#              documentary and reserved for a future single-source wiring.)
#
# Adopting a new release (e.g. 3.25): set STABLE=v3.25 and PREVIOUS=v3.24.
# discover-alpine.yml automates detection + notification; the buildchain fix
# itself stays a human edit (here) so the per-line musl/toolchain breakage a new
# base causes gets fixed in a branch before publish - the failure frontier is
# not known until the build runs.
#
# Values are the repo-dir form (matches ALPINE_VERSION in the Makefile and the
# repository/<vX.Y>/ output tree); the Docker image-tag form strips the leading
# "v" (see ALPINE_TAG in the Makefile).
STABLE=v3.24
PREVIOUS=
EDGE=edge
